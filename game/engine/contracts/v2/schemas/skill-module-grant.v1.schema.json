{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/skill-module-grant.v1.schema.json",
  "title": "Grey Crow Skill Module grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "moduleRef", "definitionHash", "read", "writableFields", "limitsVersion"],
  "properties": {
    "schemaVersion": { "const": "grey-crow-skill-module-grant-v1" },
    "moduleRef": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "definitionHash": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    },
    "read": { "const": true },
    "writableFields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fieldId", "operations"],
        "properties": {
          "fieldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["set", "append", "remove_by_id", "clear"] }
          }
        }
      }
    },
    "limitsVersion": { "const": 1 }
  }
}
