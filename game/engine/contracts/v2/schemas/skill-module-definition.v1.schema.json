{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/skill-module-definition.v1.schema.json",
  "title": "Grey Crow Skill Module definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stateVersion", "visibility", "summaryFields", "fields"],
  "properties": {
    "schemaVersion": { "const": "grey-crow-skill-module-definition-v1" },
    "stateVersion": { "const": 1 },
    "visibility": { "enum": ["visible", "hidden_until_active"] },
    "summaryFields": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fieldId" }
    },
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/action" }
    },
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "fieldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "actionDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "toolName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/fieldId" },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "label"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 0, "maximum": 100 },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["count", "count_progress"] },
        "target": { "type": "integer", "minimum": 1, "maximum": 100 },
        "milestones": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/milestone" }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widget"],
      "properties": {
        "widget": {
          "enum": [
            "number",
            "progress",
            "meter",
            "text",
            "multiline",
            "indicator",
            "badge",
            "chips",
            "list",
            "cards",
            "timeline",
            "table"
          ]
        },
        "groupCountBy": { "$ref": "#/$defs/fieldId" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "scalarValue": {
      "anyOf": [
        { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        { "type": "string", "maxLength": 2000 },
        { "type": "boolean" }
      ]
    },
    "recordDefaultItem": {
      "type": "object",
      "maxProperties": 12,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": { "$ref": "#/$defs/scalarValue" }
      },
      "additionalProperties": false
    },
    "defaultValue": {
      "anyOf": [
        { "$ref": "#/$defs/scalarValue" },
        {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 240 }
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/recordDefaultItem" }
        }
      ]
    },
    "runtimeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "source", "fallback"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/fieldId" },
        "source": { "enum": ["current_game_day"] },
        "fallback": { "enum": ["unavailable", "current_turn"] }
      }
    },
    "constantField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "value"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/fieldId" },
        "value": { "$ref": "#/$defs/scalarValue" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "toolName",
        "description",
        "archetype",
        "targetField",
        "modelFields",
        "runtimeFields",
        "constantFields",
        "allowedValues",
        "namedPolicy",
        "namedTransition"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "toolName": { "$ref": "#/$defs/toolName" },
        "description": { "$ref": "#/$defs/actionDescription" },
        "archetype": { "enum": ["append_record", "choose_enum"] },
        "targetField": { "$ref": "#/$defs/fieldId" },
        "modelFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldId" }
        },
        "runtimeFields": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/runtimeField" }
        },
        "constantFields": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/constantField" }
        },
        "allowedValues": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldId" }
        },
        "namedPolicy": {
          "enum": ["none", "memory_fragment_record_v1", "memory_fragment_resolution_v1"]
        },
        "namedTransition": {
          "enum": ["none", "unlock_at_record_limit"]
        }
      }
    },
    "itemField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["integer", "number", "text", "boolean", "enum"] },
        "minimum": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "maximum": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "default", "modelWritable", "allowedOperations", "display"],
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["integer", "number", "text", "boolean", "enum", "string_list", "record_list"] },
        "default": { "$ref": "#/$defs/defaultValue" },
        "modelWritable": { "type": "boolean" },
        "allowedOperations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["set", "append", "remove_by_id", "clear"] }
        },
        "minimum": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "maximum": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "itemMaxLength": { "type": "integer", "minimum": 1, "maximum": 240 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/option" }
        },
        "itemFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/itemField" }
        },
        "display": { "$ref": "#/$defs/display" }
      }
    }
  }
}
