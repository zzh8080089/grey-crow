{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/extreme-ending-easter-receipt.v1.schema.json",
  "title": "Grey Crow extreme ending Easter one-shot outcome receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "operationId",
    "candidateId",
    "policyVersion",
    "policyHash",
    "chanceBasisPoints",
    "drawBasisPoints",
    "outcome",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-extreme-ending-easter-receipt-v1" },
    "receiptId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "operationId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "candidateId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "policyVersion": { "const": "grey-crow-easter-outcome-policy-v1" },
    "policyHash": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    },
    "chanceBasisPoints": { "const": 4440 },
    "drawBasisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "outcome": { "enum": ["standard_extreme_ending", "grey_crow_view"] },
    "decidedAt": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
    }
  }
}
