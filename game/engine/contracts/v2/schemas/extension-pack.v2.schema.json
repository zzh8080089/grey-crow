{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-23/extension-pack.v2.schema.json",
  "title": "Grey Crow Extension Pack v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "author",
    "engineCompatibility",
    "languages",
    "provides",
    "permissions",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-extension-pack-v2" },
    "id": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
    },
    "title": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
    },
    "version": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/semver"
    },
    "author": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
    },
    "engineCompatibility": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z<>=~^.*xX| -]+$"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/provideItem" }
    },
    "permissions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["read_base_content", "write_current_saveRoot_via_tools", "menu_command"]
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "provideItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "path", "language", "description", "danger"],
      "properties": {
        "type": { "enum": ["host", "world", "skill", "new_game_preset"] },
        "id": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "title": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
        },
        "path": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        },
        "language": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
        },
        "description": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/description"
        },
        "danger": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/danger"
        },
        "skillClass": {
          "enum": ["ordinary", "new_game"]
        },
        "triggers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "templates": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
          }
        },
        "readScopes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["state", "memory", "transcript", "chapters", "world", "skill", "content_snapshot"]
          }
        },
        "writeScopes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["state", "memory", "chapter", "world_records", "character_records", "item_records", "timeline"]
          }
        },
        "replaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["itemId", "compatibleVersion"],
          "properties": {
            "itemId": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
            },
            "compatibleVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9A-Za-z<>=~^.*xX| -]+$"
            }
          }
        },
        "playerGuide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "module": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "path"],
          "properties": {
            "schemaVersion": { "const": "grey-crow-skill-module-ref-v1" },
            "path": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
            }
          }
        },
        "skillIO": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "path"],
          "properties": {
            "schemaVersion": { "const": "grey-crow-skill-io-ref-v1" },
            "path": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
            }
          }
        },
        "localization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "path"],
          "properties": {
            "schemaVersion": {
              "enum": [
                "grey-crow-skill-localization-ref-v1",
                "grey-crow-narrative-localization-ref-v1"
              ]
            },
            "path": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "skill" } },
            "required": ["type"]
          },
          "then": {
            "required": ["skillClass", "triggers", "templates", "readScopes", "writeScopes"],
            "properties": {
              "skillClass": true,
              "triggers": true,
              "templates": true,
              "readScopes": true,
              "writeScopes": true,
              "playerGuide": true,
              "module": true,
              "skillIO": true,
              "localization": true
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["host", "world"] } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "localization": {
                "type": "object",
                "properties": {
                  "schemaVersion": { "const": "grey-crow-narrative-localization-ref-v1" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "skill" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "localization": {
                "type": "object",
                "properties": {
                  "schemaVersion": { "const": "grey-crow-skill-localization-ref-v1" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
