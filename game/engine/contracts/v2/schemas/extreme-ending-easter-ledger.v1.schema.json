{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/extreme-ending-easter-ledger.v1.schema.json",
  "title": "Grey Crow extreme ending Easter lifecycle ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adventureId",
    "revision",
    "phase",
    "skillIdentity",
    "candidate",
    "confirmations",
    "terminalOperationId",
    "outcomeReceipt",
    "finaleOperationId",
    "closedFinale",
    "continuationPolicy",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-extreme-ending-easter-ledger-v1" },
    "adventureId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "phase": {
      "enum": [
        "idle",
        "confirmation_1_pending",
        "confirmation_2_pending",
        "confirmation_3_pending",
        "terminal_committed",
        "finalizing",
        "recovery_required",
        "closed"
      ]
    },
    "skillIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "ownership", "packId", "itemId", "moduleRef", "contentHash"],
      "properties": {
        "schemaVersion": { "const": "grey-crow-easter-skill-identity-v1" },
        "ownership": { "const": "built_in" },
        "packId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "itemId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "moduleRef": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
        },
        "contentHash": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "candidate": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://greycrow.local/schemas/p2-25/extreme-ending-easter-candidate.v1.schema.json" }
      ]
    },
    "confirmations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "https://greycrow.local/schemas/p2-25/extreme-ending-easter-confirmation.v1.schema.json"
      }
    },
    "terminalOperationId": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef" }
      ]
    },
    "outcomeReceipt": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://greycrow.local/schemas/p2-25/extreme-ending-easter-receipt.v1.schema.json" }
      ]
    },
    "finaleOperationId": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef" }
      ]
    },
    "closedFinale": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["finaleId", "chapterId", "closedAt"],
          "properties": {
            "finaleId": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
            },
            "chapterId": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
            },
            "closedAt": {
              "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
            }
          }
        }
      ]
    },
    "continuationPolicy": { "const": "forbidden" },
    "createdAt": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
    }
  }
}
