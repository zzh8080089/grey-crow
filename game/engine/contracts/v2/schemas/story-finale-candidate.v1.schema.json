{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/story-finale-candidate.v1.schema.json",
  "title": "Grey Crow Story Finale candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "proposedTurn",
    "proposedAt",
    "fingerprint",
    "closureReason",
    "closedThreads",
    "intentionalOpenThreads",
    "finaleTone"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-story-finale-candidate-v1" },
    "candidateId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "proposedTurn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "proposedAt": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
    },
    "fingerprint": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    },
    "closureReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "closedThreads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
      }
    },
    "intentionalOpenThreads": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
      }
    },
    "finaleTone": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
    }
  }
}
