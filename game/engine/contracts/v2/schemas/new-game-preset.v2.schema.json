{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/new-game-preset.v2.schema.json",
  "title": "Grey Crow New Game preset v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "language", "host", "world", "newGameSkill", "skills"],
  "properties": {
    "schemaVersion": { "const": "grey-crow-new-game-preset-v2" },
    "id": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
    },
    "language": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
      }
    },
    "localizedMetadata": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "title", "description"],
        "properties": {
          "locale": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
          },
          "title": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
          },
          "description": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/description"
          }
        }
      }
    },
    "host": { "$ref": "#/$defs/itemRef" },
    "world": { "$ref": "#/$defs/itemRef" },
    "newGameSkill": { "$ref": "#/$defs/itemRef" },
    "skills": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/itemRef" }
    },
    "optionalSkills": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/optionalSkillRef" }
    }
  },
  "$defs": {
    "itemRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "itemId"],
      "properties": {
        "packId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "itemId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        }
      }
    },
    "optionalSkillRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "itemId", "defaultEnabled"],
      "properties": {
        "packId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "itemId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "defaultEnabled": { "type": "boolean" }
      }
    }
  }
}
