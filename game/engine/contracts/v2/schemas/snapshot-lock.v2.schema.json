{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-23/snapshot-lock.v2.schema.json",
  "title": "Grey Crow adventure content snapshot lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockId",
    "profileId",
    "createdAt",
    "overallHash",
    "items",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-snapshot-lock-v2" },
    "lockId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "profileId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "createdAt": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
    },
    "overallHash": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": ["skill-panel-presentation-v1", "skill-panel-presentation-v2", "skill-module-v1", "skill-io-companion-v1", "skill-localization-v1", "built-in-domain-skill-io-v1", "general-skill-core-facade-v1"]
      }
    },
    "skillPanelPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": { "const": "skill-panels.lock.json" },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "skillPanelPresentationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": { "const": "skill-panels-v2.lock.json" },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "moduleReviewHash": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    },
    "skillLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": { "const": "skill-localizations.lock.json" },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "builtInDomainSkills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/builtInDomainSkillLock" }
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 66,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packId", "packVersion", "itemId", "itemType", "language", "sha256"],
        "properties": {
          "packId": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
          },
          "packVersion": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/semver"
          },
          "itemId": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
          },
          "itemType": { "enum": ["host", "world", "skill", "new_game_preset"] },
          "title": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
          },
          "skillClass": { "enum": ["ordinary", "new_game"] },
          "language": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
          },
          "sha256": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
          },
          "skillModule": {
            "$ref": "#/$defs/skillModuleLock"
          },
          "skillIO": {
            "$ref": "#/$defs/skillIOLock"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "itemType": { "const": "skill" } },
              "required": ["itemType"]
            },
            "then": {
              "required": ["skillClass"],
              "properties": { "skillClass": true }
            },
            "else": { "not": { "required": ["skillClass"] } }
          },
          {
            "if": {
              "properties": {
                "itemType": { "const": "skill" },
                "skillClass": { "const": "ordinary" }
              },
              "required": ["itemType", "skillClass"]
            },
            "then": true,
            "else": {
              "allOf": [
                {
                  "not": {
                    "type": "object",
                    "properties": { "skillModule": { "$ref": "#/$defs/skillModuleLock" } },
                    "required": ["skillModule"]
                  }
                },
                {
                  "not": {
                    "type": "object",
                    "properties": { "skillIO": { "$ref": "#/$defs/skillIOLock" } },
                    "required": ["skillIO"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "sha256", "sizeBytes"],
        "properties": {
          "relativePath": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
          },
          "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }
        }
      }
    }
  },
  "$defs": {
    "builtInDomainSkillResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "builtInDomainSkillLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "capability", "companion", "grant", "lock"],
      "properties": {
        "skillId": { "const": "characters" },
        "capability": { "const": "character_records" },
        "companion": {
          "allOf": [
            { "$ref": "#/$defs/builtInDomainSkillResource" },
            { "type": "object", "properties": { "relativePath": { "const": "built-in-skills/characters/companion.json" } } }
          ]
        },
        "grant": {
          "allOf": [
            { "$ref": "#/$defs/builtInDomainSkillResource" },
            { "type": "object", "properties": { "relativePath": { "const": "built-in-skills/characters/grant.json" } } }
          ]
        },
        "lock": {
          "allOf": [
            { "$ref": "#/$defs/builtInDomainSkillResource" },
            { "type": "object", "properties": { "relativePath": { "const": "built-in-skills/characters/lock.json" } } }
          ]
        }
      }
    },
    "skillIOId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "skillModuleLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "moduleRef",
        "definitionHash",
        "definitionSchemaVersion",
        "stateVersion",
        "grant"
      ],
      "properties": {
        "schemaVersion": { "const": "grey-crow-skill-module-lock-v1" },
        "moduleRef": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
        },
        "definitionHash": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        },
        "definitionSchemaVersion": { "const": "grey-crow-skill-module-definition-v1" },
        "stateVersion": { "const": 1 },
        "grant": {
          "$ref": "https://greycrow.local/schemas/p2-25/skill-module-grant.v1.schema.json"
        }
      }
    },
    "skillIOLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "namespace", "companionHash", "companionSchemaVersion", "moduleRef", "readViewIds", "actionIds"],
      "properties": {
        "schemaVersion": { "const": "grey-crow-skill-io-lock-v1" },
        "namespace": { "$ref": "#/$defs/skillIOId" },
        "companionHash": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        },
        "companionSchemaVersion": { "const": "grey-crow-skill-io-companion-v1" },
        "moduleRef": {
          "anyOf": [
            { "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef" },
            { "type": "null" }
          ]
        },
        "readViewIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["guide", "overview", "recent", "lookup"] }
        },
        "actionIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skillIOId" }
        }
      }
    }
  }
}
