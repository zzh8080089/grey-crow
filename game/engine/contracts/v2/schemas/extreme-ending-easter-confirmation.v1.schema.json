{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/extreme-ending-easter-confirmation.v1.schema.json",
  "title": "Grey Crow extreme ending Easter confirmation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "confirmationId",
    "candidateId",
    "stage",
    "playerTurn",
    "confirmedAt",
    "playerTextExcerpt",
    "playerTextSha256",
    "interpretationReason"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-extreme-ending-easter-confirmation-v1" },
    "confirmationId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "candidateId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
    },
    "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "playerTurn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "confirmedAt": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/timestamp"
    },
    "playerTextExcerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "playerTextSha256": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    },
    "interpretationReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}
