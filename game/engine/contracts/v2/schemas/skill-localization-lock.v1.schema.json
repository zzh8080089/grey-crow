{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-26/skill-localization-lock.v1.schema.json",
  "title": "Grey Crow locked Skill localization resources v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": { "const": "grey-crow-skill-localization-lock-v1" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65,
      "items": { "$ref": "#/$defs/skillLock" }
    }
  },
  "$defs": {
    "nullableGuide": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 2000 }
      ]
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "nullableFileDescriptor": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/fileDescriptor" }
      ]
    },
    "templateDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "relativePath", "sha256"],
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 89,
          "pattern": "^template:[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "relativePath": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "localeLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "title",
        "description",
        "triggers",
        "playerGuide",
        "body",
        "templates",
        "modulePresentation"
      ],
      "properties": {
        "locale": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
        },
        "title": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
        },
        "description": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/description"
        },
        "triggers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "playerGuide": { "$ref": "#/$defs/nullableGuide" },
        "body": { "$ref": "#/$defs/fileDescriptor" },
        "templates": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/templateDescriptor" }
        },
        "modulePresentation": { "$ref": "#/$defs/nullableFileDescriptor" }
      }
    },
    "skillLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId",
        "packVersion",
        "itemId",
        "skillClass",
        "danger",
        "sourceLocale",
        "locales"
      ],
      "properties": {
        "packId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "packVersion": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/semver"
        },
        "itemId": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
        },
        "ownership": { "enum": ["built_in", "player_owned", "imported_readonly"] },
        "skillClass": { "enum": ["ordinary", "new_game"] },
        "danger": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/danger"
        },
        "sourceLocale": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/localeLock" }
        }
      }
    }
  }
}
