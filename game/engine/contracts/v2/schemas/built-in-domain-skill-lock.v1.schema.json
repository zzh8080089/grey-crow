{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-27/built-in-domain-skill-lock.v1.schema.json",
  "title": "Grey Crow built-in domain Skill lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "namespace",
    "capability",
    "companion",
    "grant",
    "readViewIds",
    "actions"
  ],
  "properties": {
    "schemaVersion": { "const": "grey-crow-built-in-domain-skill-lock-v1" },
    "skillId": { "$ref": "#/$defs/id" },
    "namespace": { "$ref": "#/$defs/id" },
    "capability": { "const": "character_records" },
    "companion": { "$ref": "#/$defs/lockedContract" },
    "grant": { "$ref": "#/$defs/lockedContract" },
    "readViewIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["guide", "overview", "recent", "lookup"] }
    },
    "actions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/lockedAction" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "lockedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sha256"],
      "properties": {
        "schemaVersion": {
          "enum": [
            "grey-crow-built-in-domain-skill-io-v1",
            "grey-crow-built-in-domain-skill-grant-v1"
          ]
        },
        "sha256": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
        }
      }
    },
    "lockedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "toolName"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "toolName": { "$ref": "#/$defs/id" }
      }
    }
  }
}
