{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-25/skill-module-capability-review.v1.schema.json",
  "title": "Grey Crow Skill Module capability review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules", "limitsSummary", "risk", "reviewHash"],
  "properties": {
    "schemaVersion": { "const": "grey-crow-skill-module-capability-review-v1" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleRef", "title", "required", "enabled", "writeSummary"],
        "properties": {
          "moduleRef": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/stableRef"
          },
          "title": {
            "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
          },
          "required": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "writeSummary": { "type": "string", "minLength": 1, "maxLength": 400 },
          "readSummary": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "limitsSummary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "risk": { "const": "local_module_state" },
    "reviewHash": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/sha256"
    }
  }
}
