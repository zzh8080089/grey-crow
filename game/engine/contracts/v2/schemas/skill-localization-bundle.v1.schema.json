{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greycrow.local/schemas/p2-26/skill-localization-bundle.v1.schema.json",
  "title": "Grey Crow Skill localization bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "itemId", "sourceLocale", "locales"],
  "properties": {
    "schemaVersion": { "const": "grey-crow-skill-localization-bundle-v1" },
    "itemId": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/identifier"
    },
    "sourceLocale": {
      "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/localeResource" }
    }
  },
  "$defs": {
    "nullableGuide": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 2000 }
      ]
    },
    "nullablePath": {
      "anyOf": [
        { "type": "null" },
        {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        }
      ]
    },
    "templateResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "path"],
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 89,
          "pattern": "^template:[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "path": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        }
      }
    },
    "localeResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "title",
        "description",
        "triggers",
        "playerGuide",
        "skillPath",
        "templates",
        "modulePresentationPath"
      ],
      "properties": {
        "locale": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/language"
        },
        "title": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/shortText"
        },
        "description": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/description"
        },
        "triggers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "playerGuide": { "$ref": "#/$defs/nullableGuide" },
        "skillPath": {
          "$ref": "https://greycrow.local/schemas/p2-23/common.v2.schema.json#/$defs/relativePath"
        },
        "templates": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/templateResource" }
        },
        "modulePresentationPath": { "$ref": "#/$defs/nullablePath" }
      }
    }
  }
}
