{
  "name": "grey-crow-desktop-shell",
  "productName": "Grey Crow",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Grey Crow desktop shell prototype",
  "main": "main.js",
  "build": {
    "beforePack": "scripts/write-build-identity.js",
    "appId": "app.greycrow.desktop",
    "directories": {
      "buildResources": "build"
    },
    "asarUnpack": [
      "tts-kokoro-original-worker.py"
    ],
    "files": [
      "package.json",
      "main.js",
      "problem-report.js",
      "build-identity.js",
      "build-identity.json",
      "debug-trace-summary.js",
      "preload.js",
      "app-data.js",
      "credential-store.js",
      "content-library.js",
      "content-library-zip.js",
      "content-management.js",
      "model-connections.js",
      "desktop-status.js",
      "runtime-session.js",
      "window-modes.js",
      "context-settings-policy.js",
      "settings-store.js",
      "tutorial-store.js",
      "speech-input/desktop.js",
      "speech-input/resources.js",
      "speech-input/service.js",
      "speech-input/settings.js",
      "save-slots.js",
      "provider-https-transport.js",
      "tts-kokoro-original-provider.js",
      "tts-kokoro-original-worker.py",
      "THIRD_PARTY_NOTICES.md",
      "renderer/**",
      "!renderer/**/*.test.js",
      "!renderer/assets/start_page_bg.jpg",
      "!renderer/assets/the_grey_crow_logo.png",
      "!renderer/assets/branding/grey-crow-ai-logo.png",
      "!renderer/assets/ui/input-bar-bg-aged-paper-square-02.png",
      "!renderer/assets/ui/icons/icon-backpack-01.png",
      "!renderer/assets/ui/icons/icon-location-index-01.png",
      "!renderer/assets/ui/icons/icon-observe-eye-01.png",
      "!renderer/assets/ui/icons/icon-settings-gear-01.png"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "speech-input/.runtime/darwin-arm64",
          "to": "speech-input",
          "filter": [
            "bin/**",
            "lib/**",
            "licenses/**",
            "sources/**",
            "runtime-manifest.json"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSAudioCaptureUsageDescription": null,
        "NSBluetoothAlwaysUsageDescription": null,
        "NSBluetoothPeripheralUsageDescription": null,
        "NSCameraUsageDescription": null,
        "NSMicrophoneUsageDescription": "将你的语音在本机转换为游戏输入文字。仅在你开始录音时使用麦克风。"
      }
    },
    "win": {
      "extraResources": [
        {
          "from": "speech-input/.runtime/win32-x64",
          "to": "speech-input",
          "filter": [
            "bin/**",
            "lib/**",
            "licenses/**",
            "sources/**",
            "runtime-manifest.json"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "speech-input/.model",
        "to": "speech-input-model",
        "filter": [
          "model.int8.onnx",
          "tokens.txt",
          "LICENSE",
          "SOURCE.json",
          "FunASR-MODEL_LICENSE-58830eca.txt"
        ]
      },
      {
        "from": "../../../engine",
        "to": "engine",
        "filter": [
          "bridge/index.js",
          "bridge/session-desktop-bridge.js",
          "content-v2/built-in-domain-skill-io.js",
          "content-v2/built-in-pack.js",
          "content-v2/content-library.js",
          "content-v2/generated/pack-resolver.cjs",
          "content-v2/index.js",
          "content-v2/pack-validator.js",
          "content-v2/player-profile-store.js",
          "content-v2/skill-locale-resolver.js",
          "content-v2/skill-module-creator.js",
          "content-v2/skill-module-preview.js",
          "content-v2/skill-module-snapshot.js",
          "content-v2/skill-panel-preview.js",
          "content-v2/snapshot-compiler.js",
          "content-v2/snapshot-reader.js",
          "content-v2/snapshot-utils.js",
          "contracts/v2/generated/validators.cjs",
          "contracts/v2/index.js",
          "contracts/v2/schema-registry.json",
          "contracts/v2/semantic-checks.js",
          "localization/index.js",
          "localization/locale-registry.js",
          "providers/connection-probe.js",
          "providers/deepseek.js",
          "providers/index.js",
          "providers/locale-check.js",
          "providers/mock.js",
          "providers/model-catalog.js",
          "providers/openai-compatible.js",
          "providers/provider-contracts.js",
          "providers/provider-errors.js",
          "providers/provider-registry.js",
          "runtime/context-window-policy.js",
          "runtime/model-time-policy.js",
          "runtime/storage-utils.js",
          "session/adventure-session.js",
          "session/session-archive.js",
          "session/session-catalog.js",
          "session/session-chapter-store.js",
          "session/session-chapters.js",
          "session/session-compaction-quotes.js",
          "session/session-compaction-store.js",
          "session/session-process-owner.js",
          "session/session-compaction.js",
          "session/session-context-history.js",
          "session/session-context.js",
          "session/session-execution.js",
          "session/session-execution-store.js",
          "session/session-continuation.js",
          "session/session-finale-model.js",
          "session/session-finale-store.js",
          "session/session-finale.js",
          "session/session-lineage.js",
          "session/session-memory-fragment-projection.js",
          "session/session-memory-fragment-sources.js",
          "session/session-memory-fragments.js",
          "session/session-memory-source.js",
          "session/session-new-game-lifecycle.js",
          "session/session-opening.js",
          "session/session-process-child.js",
          "session/session-provider-error.js",
          "session/session-repair-feedback.js",
          "session/session-process.js",
          "session/session-projection.js",
          "session/session-story-export.js",
          "session/session-story-history.js",
          "session/session-terminal-store.js",
          "session/turn-coordinator.js",
          "session/turn-generator.js",
          "session/turn-request.js",
          "session/turn-memory.js",
          "session/turn-model.js",
          "session/session-character-conditions.js",
          "session/session-condition-sources.js",
          "session/turn-store.js",
          "tts/tts-service.js",
          "tts/utterance-planner.js",
          "contracts/v2/schemas/*.json",
          "!**/smoke.js",
          "!**/*.test.js",
          "!**/*.spec.js",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/test-fixtures/**",
          "!**/*.md"
        ]
      },
      {
        "from": "../../../content",
        "to": "content",
        "filter": [
          "packs/**",
          "host/grey-crow-host.md",
          "skills/index.v1.json",
          "skills/*/SKILL.md",
          "skills/*/templates/*.md",
          "!skills/_template/**",
          "!skills/tool-specs.v1.json",
          "!skills/runtime-skill-rewrites.v1.json"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../../../LICENSE",
        "to": "licenses/Grey-Crow-LICENSE.txt"
      }
    ]
  },
  "scripts": {
    "build:contracts": "node scripts/build-contract-validators.js",
    "check:contracts": "node scripts/build-contract-validators.js --check",
    "check:generic-skill-panel-contract": "node scripts/check-generic-skill-panel-contract.js",
    "build:content-v2": "node scripts/build-content-v2-resolver.js",
    "check:content-v2": "node scripts/build-content-v2-resolver.js --check",
    "build:content-packs": "node scripts/build-builtin-content-pack.js",
    "check:content-packs": "node scripts/build-builtin-content-pack.js --check",
    "check:ui-localization": "node scripts/check-ui-localization.js",
    "check:character-domain-contract": "node scripts/check-character-domain-companion-contract.js",
    "precheck": "npm run check:content-v2 && npm run check:content-packs && npm run check:ui-localization && node scripts/check-window-modes.js",
    "smoke:sqlite-node": "node scripts/check-sqlite-runtime.js",
    "smoke:sqlite-electron": "node scripts/check-sqlite-runtime.js --electron",
    "start": "electron .",
    "prepare:speech-input": "node scripts/prepare-speech-input-runtime.js",
    "prepare:speech-input:windows": "node scripts/prepare-speech-input-windows.js",
    "prepare:speech-input:model": "node scripts/prepare-speech-input-model.js",
    "check:speech-input": "node --test speech-input/*.test.js renderer/speech-input.test.js",
    "smoke:speech-input": "node scripts/check-speech-input-desktop.js",
    "pack:dir": "npm run pack:dir:mac",
    "check:packaged:win": "node scripts/check-packaging-boundary.js --platform=win",
    "check:packaged:win:tts": "node scripts/check-packaging-boundary.js --platform=win --require-tts",
    "check:packaging-source": "node scripts/check-packaging-boundary.js --source-only",
    "pack:dir:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac --arm64 --config.mac.identity=null && node scripts/fix-macos-plist.js --adhoc-sign",
    "pack:dir:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --win --x64 --config.win.target=dir",
    "smoke:dev-startup": "node scripts/check-dev-startup.js",
    "smoke:packaged:win": "node scripts/check-dev-startup.js --packaged-win",
    "smoke:tts-original-provider": "node scripts/check-kokoro-original-provider.js",
    "smoke:tts-original-runtime": "node scripts/check-kokoro-original-runtime.js --allow-local-model",
    "smoke:tts-planner": "node scripts/check-tts-utterance-planner.js",
    "smoke:ui": "node scripts/check-session-desktop.js",
    "smoke:ui:notebook": "node scripts/check-session-desktop.js",
    "check": "npm run check:contracts && npm run check:generic-skill-panel-contract && npm run check:content-regression && node --check main.js && node --check preload.js && node --check renderer/app.js && node --check scripts/check-dev-startup.js && node --check scripts/check-session-desktop.js && node scripts/check-static.js && npm run check:renderer-boundaries && npm run check:settings-interactions && node scripts/check-app-data.js && node scripts/check-credential-store.js && node scripts/check-model-connections.js && node scripts/check-settings-store.js && npm run check:player-guide && npm run check:speech-input && node scripts/check-provider-https-transport.js && node scripts/check-desktop-status.js && node scripts/check-runtime-session.js && node scripts/check-tts-service.js && node scripts/check-tts-utterance-planner.js && node scripts/check-kokoro-original-provider.js && node scripts/check-content-management.js && npm run check:session && node scripts/check-packaging-boundary.js --source-only && npm run smoke:dev-startup && npm run smoke:ui",
    "check:session": "node --test ../../../engine/session/*.test.js ../../../engine/bridge/session-desktop-bridge.test.js save-slots.session.test.js",
    "smoke:ui:default-entry": "node scripts/check-session-desktop.js --suite=default-entry",
    "check:content-regression": "node --test ../../../engine/content-v2/tests/content-regression.test.js",
    "smoke:ui:observability": "node scripts/check-session-desktop.js --suite=observability",
    "check:renderer-boundaries": "node scripts/check-session-renderer-boundaries.js && node renderer/notebook-book.lifecycle.test.js && node renderer/notebook-quill.test.js",
    "smoke:ui:notebook-entry": "node scripts/check-session-desktop.js --suite=notebook-entry",
    "smoke:ui:save-policy": "node scripts/check-session-desktop.js --suite=save-policy",
    "smoke:ui:layout": "node scripts/check-notebook-layout.js",
    "smoke:ui:display": "node scripts/check-notebook-layout.js --display",
    "smoke:ui:feedback": "node scripts/check-notebook-layout.js --feedback",
    "check:settings-interactions": "node scripts/check-settings-interactions.js && node scripts/check-model-connection-transactions.js",
    "smoke:ui:player-settings": "node scripts/check-session-desktop.js --suite=player-settings",
    "smoke:ui:player-report": "node scripts/check-session-desktop.js --suite=player-report",
    "check:player-guide": "node --test tutorial-store.test.js && node --check renderer/player-guide.js && node --check renderer/player-guide-content.js && node --check renderer/game-tour.js && node --check renderer/game-tour-lifecycle.js",
    "smoke:ui:game-tour": "node scripts/check-session-desktop.js --suite=game-tour",
    "smoke:ui:player-guide": "node scripts/check-session-desktop.js --suite=player-guide"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "electron": "42.6.1",
    "electron-builder": "26.15.6",
    "esbuild": "0.28.1",
    "semver": "7.8.5"
  },
  "dependencies": {
    "undici": "8.7.0",
    "yauzl": "3.4.0"
  }
}
